[Unit]
Description=Hevea Gateway bootstrap
DefaultDependencies=no
After=haos-supervisor.service
Wants=haos-supervisor.service

# Run only once: install the Hevea store repo, then install addons.
# ConditionPathExists=! checks that the marker file does NOT exist.
# Once the service completes, the marker file is created by the script.
ConditionPathExists=!/mnt/overlay/etc/hevea-gateway.complete

[Service]
Type=oneshot
ExecStart=/usr/libexec/hevea-gateway.sh
RemainAfterExit=yes
SuccessExitStatus=2
# First boot may install add-ons (pulling their images): no start timeout.
TimeoutStartSec=0
# Show the bootstrap progress on the console (HDMI/serial) as well as in the
# journal: it is the only feedback during a first boot.
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
